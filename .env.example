# Copy to .env, set permissions 0600. Plain KEY=value; no quotes or interpolation.
# Existing deployment may use a symlink to a protected file outside the repository.
Telegram__Token=
BotSecurity__OwnerUserId=
# Optional private Chat ID; defaults to OwnerUserId.
BotSecurity__OwnerChatId=
OpenCode__BaseUrl=http://127.0.0.1:49374
OpenCode__Username=opencode
OpenCode__Password=

# Absolute host paths; bind mounts preserve the same paths inside Docker.
MANAGER_PROJECTS_ROOT=
MANAGER_DATA_DIR=
MANAGER_UID=
MANAGER_GID=
# Optional override: Compose secret file. Defaults to .env.
MANAGER_ENV_FILE=
# Local dotnet run also reads this file when set in the process environment:
# Manager__EnvironmentFile=/absolute/path/to/.env

TaskExecution__MaxConcurrentTasks=2
TaskExecution__MaxDurationMinutes=60
TaskExecution__MaxToolCalls=200
Autonomy__Enabled=true
# Optional host dependency caches for the isolated executor.
Autonomy__ReadOnlyCaches__0=
Autonomy__ReadOnlyCaches__1=
Autonomy__NugetPackages=
